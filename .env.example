CONTAINER_REGISTRY_PREFIX=docker.m.daocloud.io
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_DB=threat_agent
POSTGRES_USER=threat_agent
POSTGRES_PASSWORD=change-this-before-deployment
MINIO_ROOT_USER=threat_agent
MINIO_ROOT_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql+psycopg://threat_agent:change-this-before-deployment@postgres:5432/threat_agent
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=analysis-content
OBJECT_STORE_ACCESS_KEY=threat_agent
OBJECT_STORE_SECRET_KEY=change-this-before-deployment
AUDIT_SEAL_BUCKET=analysis-audit-seals
AUDIT_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_OBJECT_LOCK_DAYS=3650
AUDIT_SEAL_SECRET=change-this-before-deployment
GATE_SECRET_KEY=change-this-before-deployment
CONTENT_STORE_BACKEND=local
CONTENT_STORE_PATH=.data/content
WORKBENCH_WORKSPACE_ROOT=
# Optional host directory mounted read-only for workspace-relative imports.
# Example on Windows: WORKBENCH_WORKSPACE_HOST_ROOT=D:/test
WORKBENCH_WORKSPACE_HOST_ROOT=./workspace
TEMPORAL_ADDRESS=temporal:7233
TOOL_EXECUTION_MODE=local
TOOL_TASK_QUEUE=static-ghidra
MAX_SAMPLE_FILES=1000
MAX_SAMPLE_BYTES=536870912
MAX_ARCHIVE_DEPTH=3

# The product does not ship an analysis model. Leave these empty unless you
# want a deployment-level override. The live route is the model you save in
# the Workbench 模型配置 panel (`/api/v1/model-config`).
MODEL_PRIMARY_PROVIDER=
MODEL_PRIMARY_API_STYLE=openai
MODEL_PRIMARY_BASE_URL=
MODEL_PRIMARY_MODEL=
MODEL_PRIMARY_API_KEY=
MODEL_PRIMARY_STREAM=true
MODEL_PRIMARY_JSON_MODE=true
MODEL_PRIMARY_TEMPERATURE=0.0
MODEL_PRIMARY_TOP_P=1.0
MODEL_PRIMARY_DISABLE_REASONING=true
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_PROVIDER=
MODEL_FALLBACK_API_STYLE=openai
MODEL_FALLBACK_BASE_URL=
MODEL_FALLBACK_MODEL=
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_STREAM=true
MODEL_FALLBACK_JSON_MODE=true
MODEL_FALLBACK_TEMPERATURE=0.0
MODEL_FALLBACK_TOP_P=1.0
MODEL_FALLBACK_DISABLE_REASONING=true
MODEL_CALLS_ENABLED=false
# When true, the backend may call the Workbench-configured model for
# investigation enrichment and for analyst-report chapter overlay at
# synthesis time (including DSH-owned tasks). Official GET reports still
# get a deterministic catalog/PMA chapter plan when this is false.
# Workbench investigation uses Settings → 模型. Leave true so the backend
# does not keep a second analysis-planner model route.
DSH_CONVERSATION_OWNS_PLANNING=true
MODEL_CONTEXT_MAX_BYTES=2000000
# Static analysis calls can be slower than planning calls for large samples.
MODEL_CALL_TIMEOUT_S=180
MODEL_CALL_MAX_TOKENS=2048
# Bounded deep investigation: up to six high-value targets x five mandatory facets.
INVESTIGATION_MAX_STEPS=32
INVESTIGATION_MAX_ROUNDS=4
# Per-invocation cap across seed threads; later invocations resume deferred work.
INVESTIGATION_TASK_MAX_ACTIONS=64
# Static abstract execution walks already-exported instruction/call records; it
# never loads or runs the sample. This is a degenerate-input guard for a crafted
# image, not an analysis quota: the Ghidra exporter already stops one function at
# 10000 instruction rows, so a real function is analysed in full. Unrelated to
# INVESTIGATION_MAX_STEPS, which bounds interactive planning.
STATIC_ABSTRACT_EXECUTION_MAX_STEPS=65536
MODEL_CONFIG_SECRET_KEY=

# The product launcher rebuilds Ghidra only on explicit -BuildGhidra and
# temporarily serves this verified local archive over loopback. Do not point
# this at an unauthenticated external mirror.
GHIDRA_VERSION=
GHIDRA_ZIP_URL=
GHIDRA_SHA256=
GHIDRA_HOME=

# Default remains static-only on the host. Docker Compose overrides this to
# static-first-controlled-emulation and runs Unicorn/Speakeasy in emu-worker.
# PyPI package "speakeasy" is the wrong project; install speakeasy-emulator.
# Speakeasy pins unicorn 1.0.2; Qiling wants unicorn>=2. They are not co-installed
# in the emu-worker image. Qiling stays UNSUPPORTED without a pinned rootfs.
# SIMULATION_PROFILE=static-first-controlled-emulation
# SIMULATION_WORKER_IDENTITY=controlled-emu-worker-v1
# SIMULATION_WORKER_IMAGE_DIGEST=sha256:emu-worker-v1
# SIMULATION_ALLOWED_SIMULATORS=unicorn,speakeasy,qiling
# SIMULATION_ALLOW_LOCAL_PROCESS=false
# SIMULATION_QILING_ROOTFS=
# SIMULATION_TIMEOUT_SECONDS=8
# SIMULATION_INSTRUCTION_BUDGET=100000
# SIMULATION_MAX_OUTPUT_BYTES=65536
# SIMULATION_MAX_INPUT_BYTES=4194304
# EMU_TASK_QUEUE=static-emu
SIMULATION_PROFILE=static-only
SIMULATION_ALLOW_LOCAL_PROCESS=false
# Optional local MITRE ATT&CK enterprise index (02_techniques.json).
# When unset, the packaged distill in src/threat_report_agent/knowledge is used.
# Groups/software files are never used as attribution evidence.
# ATTACK_KNOWLEDGE_ROOT=C:/Users/王宪韬/Desktop/ATT&CK知识库
