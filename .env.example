CONTAINER_REGISTRY_PREFIX=docker.m.daocloud.io
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
POSTGRES_DB=threat_agent
POSTGRES_USER=threat_agent
POSTGRES_PASSWORD=change-this-before-deployment
MINIO_ROOT_USER=threat_agent
MINIO_ROOT_PASSWORD=change-this-before-deployment
DATABASE_URL=postgresql+psycopg://threat_agent:change-this-before-deployment@postgres:5432/threat_agent
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_BUCKET=analysis-content
OBJECT_STORE_ACCESS_KEY=threat_agent
OBJECT_STORE_SECRET_KEY=change-this-before-deployment
AUDIT_SEAL_BUCKET=analysis-audit-seals
AUDIT_OBJECT_LOCK_MODE=COMPLIANCE
AUDIT_OBJECT_LOCK_DAYS=3650
AUDIT_SEAL_SECRET=change-this-before-deployment
GATE_SECRET_KEY=change-this-before-deployment
CONTENT_STORE_BACKEND=local
CONTENT_STORE_PATH=.data/content
WORKBENCH_WORKSPACE_ROOT=
# Optional host directory mounted read-only for workspace-relative imports.
# Example on Windows: WORKBENCH_WORKSPACE_HOST_ROOT=D:/test
WORKBENCH_WORKSPACE_HOST_ROOT=./workspace
TEMPORAL_ADDRESS=temporal:7233
TOOL_EXECUTION_MODE=local
TOOL_TASK_QUEUE=static-ghidra
MAX_SAMPLE_FILES=1000
MAX_SAMPLE_BYTES=536870912
MAX_ARCHIVE_DEPTH=3

# Do not commit real credentials.
MODEL_PRIMARY_PROVIDER=deepseek
MODEL_PRIMARY_API_STYLE=openai
MODEL_PRIMARY_BASE_URL=https://api.deepseek.com/v1
MODEL_PRIMARY_MODEL=deepseek-chat
MODEL_PRIMARY_API_KEY=
MODEL_PRIMARY_STREAM=true
MODEL_PRIMARY_JSON_MODE=false
MODEL_PRIMARY_TEMPERATURE=0.6
MODEL_PRIMARY_TOP_P=0.7
MODEL_PRIMARY_DISABLE_REASONING=true
MODEL_FALLBACK_PROVIDER=glm
MODEL_FALLBACK_API_STYLE=openai
MODEL_FALLBACK_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_FALLBACK_MODEL=glm-4-flash
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_STREAM=true
MODEL_FALLBACK_JSON_MODE=true
MODEL_FALLBACK_TEMPERATURE=0.0
MODEL_FALLBACK_TOP_P=1.0
MODEL_FALLBACK_DISABLE_REASONING=true
MODEL_CALLS_ENABLED=false
MODEL_CONTEXT_MAX_BYTES=2000000
# Static analysis calls can be slower than planning calls for large samples.
MODEL_CALL_TIMEOUT_S=180
MODEL_CALL_MAX_TOKENS=2048
MODEL_CONFIG_SECRET_KEY=

# The product launcher rebuilds Ghidra only on explicit -BuildGhidra and
# temporarily serves this verified local archive over loopback. Do not point
# this at an unauthenticated external mirror.
GHIDRA_VERSION=
GHIDRA_ZIP_URL=
GHIDRA_SHA256=
GHIDRA_HOME=
