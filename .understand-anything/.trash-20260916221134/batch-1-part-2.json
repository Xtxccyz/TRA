    {
      "id": "file:src/threat_report_agent/service.py",
      "type": "file",
      "name": "service.py",
      "filePath": "src/threat_report_agent/service.py",
      "summary": "承载 Analysis Task 全生命周期的巨型服务模块（约 2.8 万行）：提交与样本包展开、Artifact/ToolRun 注册、静态分析与受控模拟派发、Evidence 与 Claim 链接、Analysis Snapshot 冻结、Report Revision 以及 DSH workbench 会话接口。现行活体调查 planner 入口是本模块的 _run_investigation_loop（配合 investigation.DeepMiningPlanner）。",
      "tags": [
        "service",
        "analysis-task",
        "workbench",
        "orchestration",
        "investigation-loop"
      ],
      "complexity": "complex",
      "languageNotes": "单模块内含一个约 2.7 万行的 AnalysisService 类与若干模块级辅助函数；节点只覆盖 1 个 file 节点加少量关键入口，方法级细节需按方法名检索。"
    },
    {
      "id": "class:src/threat_report_agent/service.py:AnalysisService",
      "type": "class",
      "name": "AnalysisService",
      "filePath": "src/threat_report_agent/service.py",
      "lineRange": [
        1045,
        28147
      ],
      "summary": "核心服务类：装配模型网关、Prompt 注册表、策略、证据仓储与（历史的）StaticInvestigationOrchestrator，并实现从创建 Case/Analysis Task、执行静态工具与受控模拟、链接 Claim 与 Evidence，到冻结 Analysis Snapshot、生成 Report Revision 与 workbench 接口的全部流程。",
      "tags": [
        "service",
        "analysis-task",
        "workbench",
        "orchestration"
      ],
      "complexity": "complex"
    },
    {
      "id": "function:src/threat_report_agent/service.py:_run_investigation_loop",
