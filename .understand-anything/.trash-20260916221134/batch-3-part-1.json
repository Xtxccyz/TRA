    {
      "id": "file:src/threat_report_agent/auth.py",
      "type": "file",
      "name": "auth.py",
      "filePath": "src/threat_report_agent/auth.py",
      "summary": "HTTP 层的身份与权限原语：Principal 描述调用主体，AuthAdapter 在生产环境校验 HS256/RS256 签名 Bearer JWT、其它环境可退回 X-Principal-* 请求头或受控 demo 身份，require_permission 供 FastAPI 路由声明所需权限。",
      "tags": ["security", "authentication", "authorization", "middleware"],
      "complexity": "moderate"
    },
    {
      "id": "class:src/threat_report_agent/auth.py:Principal",
      "type": "class",
      "name": "Principal",
      "filePath": "src/threat_report_agent/auth.py",
      "lineRange": [19, 82],
      "summary": "不可变的调用主体（subject、roles、auth_source），提供 has() 判定角色或权限归属，是授权与审计链路共享的身份载体。",
      "tags": ["security", "data-model", "authorization", "identity"],
      "complexity": "moderate"
    },
    {
      "id": "class:src/threat_report_agent/auth.py:AuthAdapter",
      "type": "class",
      "name": "AuthAdapter",
      "filePath": "src/threat_report_agent/auth.py",
      "lineRange": [85, 204],
      "summary": "身份适配器：按部署环境选择认证策略——生产环境要求签名 Bearer JWT（HS256 本地密钥或 RS256 + JWKS 缓存），非生产环境接受 X-Principal-Id/X-Principal-Roles 请求头，开启后回退到 demo 主体。",
      "tags": ["security", "authentication", "jwt", "adapter"],
      "complexity": "moderate"
    },
    {
      "id": "function:src/threat_report_agent/auth.py:require_permission",
      "type": "function",
      "name": "require_permission",
      "filePath": "src/threat_report_agent/auth.py",
      "lineRange": [207, 214],
      "summary": "FastAPI 依赖：从请求解析 Principal 并校验指定 permission，未认证抛 401、越权抛 403。",
      "tags": ["security", "authorization", "api-handler", "dependency"],
      "complexity": "simple"
    },
