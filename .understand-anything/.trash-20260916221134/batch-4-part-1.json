  "nodes": [
    {
      "id": "file:src/threat_report_agent/analysis_trace.py",
      "type": "file",
      "name": "analysis_trace.py",
      "filePath": "src/threat_report_agent/analysis_trace.py",
      "summary": "把一次分析运行投影成结构化、脱敏的分析过程视图：按 intake/triage/extraction/gate/completion 阶段组织可观察步骤，并把 Claim、Evidence、ToolRun 与机制有效性追踪串成来源链接。它只暴露可观察工作流与证据链接，绝不包含模型 prompt、原始响应、密钥或私有思维链。",
      "tags": ["分析过程追踪", "脱敏投影", "可观测性", "证据链接"],
      "complexity": "complex",
      "languageNotes": "用 _PHASES 常量表把审计事件名映射到阶段，再以一组 _compact_* 函数做白名单式字段裁剪，是典型的「默认拒绝」脱敏写法。"
    },
    {
      "id": "file:src/threat_report_agent/analyst_report.py",
      "type": "file",
      "name": "analyst_report.py",
      "filePath": "src/threat_report_agent/analyst_report.py",
      "summary": "官方分析员 markdown 报告 overlay：依据行为目录、PMA 静态规则与本样本证据规划章节主题并渲染成一份恶意样本分析报告，渲染后再跑静态措辞合规检查。它刻意不追加执行摘要、种子图、覆盖字典、函数语义转储或 Evidence UUID（那些留在 V3 ledger / Evidence Explorer），CANDIDATE 机制只作已恢复静态事实叙述而不升级为 VERIFIED。",
      "tags": ["报告渲染", "markdown", "质量门", "行为目录"],
      "complexity": "complex",
      "languageNotes": "模块内以大量单下划线辅助函数组织成「字段取值 → 语义判定 → 文本渲染」三段式管线，真正的对外 API 只有 plan_analyst_topics / apply_model_topic_plan / render_analyst_chapters / render_official_markdown 等少数几个。"
    },
