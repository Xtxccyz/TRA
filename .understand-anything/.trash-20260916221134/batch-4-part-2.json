{
  "nodes": [
    {
      "id": "file:src/threat_report_agent/deep_analysis_quality.py",
      "type": "file",
      "name": "deep_analysis_quality.py",
      "filePath": "src/threat_report_agent/deep_analysis_quality.py",
      "summary": "分析员级静态分析的确定性质量门：评估调查结果的形状与证据来源，做对抗式过度声明检查（例如 INJECTS 自环）、无新证据尸检、动作产出性与报告深度评分，并把不达标的结论降级。它从不执行样本，也绝不把 candidate 变成 verified claim。",
      "tags": ["质量门", "对抗检查", "证据来源", "评分"],
      "complexity": "complex",
      "languageNotes": "整体按「检查项 → 违例列表 → 降级」三段式组织，阈值与判定全部落在纯函数里，便于把精简结果持久化进报告快照而完整证据仍留在 ledger。"
    },
    {
      "id": "file:src/threat_report_agent/investigation_protocol.py",
      "type": "file",
      "name": "investigation_protocol.py",
      "filePath": "src/threat_report_agent/investigation_protocol.py",
      "summary": "十问调查协议与 S0–S4 静态升级阶梯：定义 initiator / input / … / failure_fallback 十个必答槽位，并规定空 prose、UNKNOWN token 与单次 NO_NEW_EVIDENCE 结果都不能关闭槽位或宣告静态边界。这些记录是调查义务而不是报告填充物。",
      "tags": ["调查协议", "状态阶梯", "静态边界", "validation"],
      "complexity": "complex",
      "languageNotes": "只依赖 collections.abc，槽位定义用 tuple-of-tuple 常量表达，判定函数全部无副作用，方便被 deep_analysis_quality 与 reporting 复用。"
    },
