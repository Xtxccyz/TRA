{
  "nodes": [
    {
      "id": "file:src/threat_report_agent/product_certification.py",
      "type": "file",
      "name": "product_certification.py",
      "filePath": "src/threat_report_agent/product_certification.py",
      "summary": "产品契约与离线认证 helper：定义受支持制品矩阵、AnalysisResultClass（FULL/BOUNDED/UNSUPPORTED/FAILED）与失败根因分类，并提供静态措辞合规检查、覆盖率与语义流/机制覆盖指标、语料切分校验、gold 评估与发布门禁。模块刻意不依赖数据库与 DSH 插件，不执行样本、不访问网络、也不把基准答案载入分析上下文。",
      "tags": ["产品认证", "发布门禁", "覆盖率", "质量门"],
      "complexity": "complex",
      "languageNotes": "为了在导入期不依赖分析管线，对 mechanism_completeness / mechanism_ready 采用函数内延迟 import；结果类与根因用 StrEnum 表达，制品矩阵是 frozen dataclass 的常量元组。"
    },
    {
      "id": "file:src/threat_report_agent/status.py",
      "type": "file",
      "name": "status.py",
      "filePath": "src/threat_report_agent/status.py",
      "summary": "产品状态枚举与任务状态机：Task Lifecycle（PENDING/RUNNING/…）描述流程阶段，Analysis Outcome（COMPLETE/PARTIAL/BLOCKED/UNSUPPORTED）描述分析完整度，两者语义不同、不可混为一谈；Claim 状态含 CANDIDATE/VERIFIED/DISPUTED/REJECTED。transition_task 依据 TASK_TRANSITIONS 表校验状态迁移。",
      "tags": ["状态机", "枚举", "产品契约", "validation"],
      "complexity": "moderate",
      "languageNotes": "把 product_certification 的 AnalysisResultClass 重新导出为 AnalysisClass 别名，使本模块成为状态词汇的统一入口。"
    },
    {
      "id": "class:src/threat_report_agent/product_certification.py:AnalysisResultClass",
      "type": "class",
      "name": "AnalysisResultClass",
      "filePath": "src/threat_report_agent/product_certification.py",
      "lineRange": [20, 26],
      "summary": "产品级结果分类（FULL_STATIC_ANALYSIS / BOUNDED_STATIC_ANALYSIS / UNSUPPORTED_ARTIFACT / FAILED_ANALYSIS），与 task lifecycle 明确分离。",
      "tags": ["enum", "结果分类", "产品契约"],
      "complexity": "simple"
    },
