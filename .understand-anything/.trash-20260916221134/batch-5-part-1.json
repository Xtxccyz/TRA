      "tags": [
        "retrieval",
        "evidence",
        "context-budget",
        "ranking",
        "检索"
      ],
      "complexity": "complex",
      "languageNotes": "用 StrEnum 表达漏斗阶段与上下文角色，用 frozen dataclass 表达检索请求与上下文包，使每次检索契约可审计、可回放。"
    },
