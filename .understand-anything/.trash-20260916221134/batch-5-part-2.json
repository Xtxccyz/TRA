      "id": "file:src/threat_report_agent/investigation_ledger.py",
      "type": "file",
      "name": "investigation_ledger.py",
      "filePath": "src/threat_report_agent/investigation_ledger.py",
      "summary": "调查工作账本：每个被发现的问题一行，是既有 Artifact → Evidence → Claim 图上的索引；状态在 OPEN / IN_PROGRESS / DEFERRED / CLOSED / UNKNOWN / UNSUPPORTED 间流转，提供登记、开始、挂起、关闭、终止与结果挂载，并在仍有 OPEN 或 DEFERRED 时拒绝判定完成。",
      "tags": [
        "work-ledger",
        "state-machine",
        "investigation",
        "台账"
      ],
      "complexity": "complex",
      "languageNotes": "所有更新都是函数式的：每个操作返回新的行列表而非就地修改，便于把账本持久化到调查线程记录里。"
    },
    {
      "id": "file:src/threat_report_agent/models.py",
      "type": "file",
      "name": "models.py",
      "filePath": "src/threat_report_agent/models.py",
      "summary": "SQLAlchemy 持久层模型：覆盖 Case / Analysis Task / Artifact / Content Blob / ToolRun / Evidence / Claim / Relation / Report Revision，以及审计链与调查线程等表，并注册 Evidence 首次落库时派生检索键的事件钩子。",
      "tags": [
        "data-model",
        "sqlalchemy",
        "persistence",
        "schema",
        "数据模型"
      ],
      "complexity": "complex",
      "languageNotes": "SQLAlchemy 2.0 declarative 风格：Mapped / mapped_column 声明列，并以 before_flush 事件在唯一约束生效前批量写入派生索引行。"
    },
