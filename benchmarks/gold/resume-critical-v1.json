{
  "version": "resume-critical-v1",
  "evaluator_only": true,
  "mechanisms": [
    {
      "id": "resume-xor",
      "components": {
        "transformation": ["xor"],
        "anchors": ["function_entry"]
      }
    },
    {
      "id": "resume-ppid",
      "components": {
        "entry": ["OpenProcess"],
        "condition": ["UpdateProcThreadAttribute"],
        "output": ["PROC_THREAD_ATTRIBUTE_PARENT_PROCESS"]
      }
    },
    {
      "id": "resume-entry",
      "components": {
        "entry": ["entrypoint"],
        "anchors": ["function_entry"]
      }
    },
    {
      "id": "resume-dynamic-api",
      "components": {
        "input": ["GetProcAddress"],
        "consumer": ["LoadLibrary"]
      }
    }
  ]
}
